# ==============================================================================
# EasyMeds Environment Variables Configuration Template
# NOTE: Do NOT commit production credentials or API keys to source control.
# ==============================================================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business Customer Support Configuration
NEXT_PUBLIC_SUPPORT_EMAIL=support@easymeds-demo.in
NEXT_PUBLIC_SUPPORT_PHONE=+919876543210
NEXT_PUBLIC_DEFAULT_PIN_CODE=400001

# Production Order Service (Backend API Integration)
# In production, replace demo client submission with an authenticated server route:
# ORDER_API_ENDPOINT=https://api.easymeds.com/v1/orders
# ORDER_API_KEY=your_order_api_secret_key

# Transactional Email Service (Optional production backend credentials)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# EMAIL_FROM=EasyMeds Orders <orders@easymeds.com>
# BUSINESS_NOTIFICATION_EMAIL=pharmacist-desk@easymeds.com
